# Real environment file for the callrack-api container on the OCI edge VM.
# Copy to /opt/apps/callrack/.env and fill in the blanks - promote.sh passes
# this straight to `docker run --env-file`, which does NOT strip quotes, so
# none of these values are quoted. This file itself is never synced from
# CI/CD; it is created and edited by hand, once, on the server.

NODE_ENV=production

# --- shared infrastructure (docker network: alpha) --------------------------
# `postgres` and `redis` resolve by container/service name on that network -
# not a managed provider, so no sslmode/rediss:// scheme is needed here.
DATABASE_URL=postgresql://callrack_owner:CHANGE_ME@postgres:5432/callrack_db?schema=public
DATABASE_POOL_MAX=10
REDIS_URL=redis://redis:6379
# Namespaces every key this instance touches so it can share the `redis`
# container's keyspace with unrelated apps without colliding.
REDIS_KEY_PREFIX=callrack:

# --- listener -----------------------------------------------------------
API_PORT=3004
API_PREFIX=v1
API_VERSION=0.1.0

# --- hardening (Caddy terminates TLS and proxies here) -----------------------
TRUST_PROXY=true
BODY_LIMIT_BYTES=1048576
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_MS=60000

# --- x402 / Algorand ------------------------------------------------------
NETWORK=mainnet
MAINNET_PAY_TO=CHANGE_ME_TO_A_REAL_ALGORAND_ADDRESS
MAINNET_FACILITATOR_URL=https://facilitator.goplausible.xyz
# Only needed if this same deployment is ever pointed at NETWORK=testnet -
# harmless to leave blank while NETWORK=mainnet.
TESTNET_PAY_TO=
TESTNET_FACILITATOR_URL=https://facilitator.goplausible.xyz

# Set only once a project-controlled refund wallet exists for this network -
# see docs/REFUNDS.md. Leaving it blank is a valid, non-fatal deployment
# state (refunds are recorded as pending but not submitted).
MAINNET_REFUND_MNEMONIC=
TESTNET_REFUND_MNEMONIC=

# --- capability pricing (USDC, decimal string, no currency symbol) ----------
# Original price x5 across the board (sum of all 16 is $1.63) - relative
# tiers unchanged, only the scale.
PRICE_ACADEMIC_SEARCH=0.05
PRICE_ACADEMIC_WORK=0.025
PRICE_NEWS_SEARCH=0.05
PRICE_NEWS_TRENDS=0.10
PRICE_CRYPTO_PRICE=0.01
PRICE_CRYPTO_MARKET=0.025
PRICE_FX_RATES=0.01
PRICE_WEATHER=0.015
PRICE_GEOCODE=0.01
PRICE_HOLIDAYS=0.01
PRICE_KNOWLEDGE_SEARCH=0.025
PRICE_GOVERNMENT_CENSUS=0.05
PRICE_RESEARCH=0.25
PRICE_INFORMATION_VERIFY=0.25
PRICE_INFORMATION_EVIDENCE=0.25
PRICE_INFORMATION_COMPARE=0.50

# --- upstream providers (all optional - omit anything you don't have) -------
OPENALEX_MAILTO=
CROSSREF_MAILTO=
COINGECKO_API_KEY=
CENSUS_API_KEY=
OPEN_METEO_BASE_URL=https://api.open-meteo.com
PHOTON_BASE_URL=https://photon.komoot.io
WIKIMEDIA_BASE_URL=https://www.wikidata.org
WIKIMEDIA_USER_AGENT=Callrack/0.1 (+https://callrack.xyz)
