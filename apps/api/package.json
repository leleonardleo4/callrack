    "@callrack/redis": "workspace:*",
    "@callrack/types": "workspace:*",
    "@fastify/cors": "^11.1.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.4",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-fastify": "^11.0.0",
    "@nestjs/swagger": "^11.0.6",
    "@x402/avm": "2.26.0",
    "@x402/core": "2.26.0",
    "@x402/extensions": "2.26.0",
    "@x402/fastify": "2.26.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "fastify": "5.12.5",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@swc/core": "^1.11.0",
    "@types/node": "^22.13.5",
    "eslint": "^9.21.0",
    "tsx": "^4.23.13",
