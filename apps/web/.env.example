# The Callrack API origin this web app talks to. Never hardcode a production
# URL in application code — this is the only place it's configured.
#
# Local development (default if unset): http://localhost:3000
# Production: https://api.callrack.xyz
VITE_API_BASE_URL=http://localhost:3000

# WalletConnect Cloud project id (https://cloud.reown.com), used by the
# Playground's WalletConnect wallet option (generic route for WalletConnect
# -compatible wallets). Optional — when unset, the WalletConnect option is
# simply not offered in the wallet connect dialog; Pera, Defly, Lute, and
# Exodus still work without it since they use their own native adapters.
VITE_WALLETCONNECT_PROJECT_ID=
