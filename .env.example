# Environment mode
NODE_ENV=development

# Infrastructure
DATABASE_URL="postgresql://callrack:callrack_dev_password@localhost:5432/callrack_dev?schema=public"
REDIS_URL="redis://localhost:6379"

# Ports
API_PORT=3000
WEB_PORT=5173

# API Configuration
API_PREFIX=v1
CORS_ORIGIN=http://localhost:5173

# Provider configuration (Phase 3)
# Optional "polite pool" identification — leave unset to use the anonymous pool.
OPENALEX_MAILTO=
CROSSREF_MAILTO=
# Optional — only needed if you have a CoinGecko API key.
COINGECKO_API_KEY=
# Optional — only needed for higher US Census API rate limits.
CENSUS_API_KEY=
# Self-hostable providers: point these at your own instance in production.
OPEN_METEO_BASE_URL=https://api.open-meteo.com
PHOTON_BASE_URL=https://photon.komoot.io
WIKIMEDIA_BASE_URL=https://www.wikidata.org
WIKIMEDIA_USER_AGENT=Callrack/0.1 (+https://callrack.dev)

# Capability pricing (Phase 6). Required — every paid capability must have
# an explicit, non-negative decimal price in USDC. There is no default: a
# missing or invalid value fails configuration validation at startup.
PRICE_ACADEMIC_SEARCH=0.01
PRICE_ACADEMIC_WORK=0.005
PRICE_NEWS_SEARCH=0.01
PRICE_NEWS_TRENDS=0.02
PRICE_CRYPTO_PRICE=0.002
PRICE_CRYPTO_MARKET=0.005
PRICE_FX_RATES=0.002
PRICE_WEATHER=0.003
PRICE_GEOCODE=0.002
PRICE_HOLIDAYS=0.002
PRICE_KNOWLEDGE_SEARCH=0.005
PRICE_GOVERNMENT_CENSUS=0.01
PRICE_RESEARCH=0.05

# x402 payment protection (Phase 7). Required — NETWORK selects which PAY_TO
# / FACILITATOR_URL pair below is active; only that pair needs to be valid
# (you don't need Mainnet credentials to develop against Testnet).
# NETWORK=testnet | mainnet
NETWORK=testnet

# Placeholder addresses below are structurally valid but NOT real wallets —
# replace with a real Algorand address you control before accepting any
# actual payment. Never commit a private key or mnemonic to this file.
TESTNET_PAY_TO=TTCZHJ24VWV64DMFCXKHS2GMLFVUTBA673THZR7LNYY3GEB3XV7HNUEQXQ
MAINNET_PAY_TO=V4BOVWHAQJUNZAPU4D7B4N2ALHVMHBRJ2F75EJG5E5XS5JFJZGAU4SS2UA

# GoPlausible facilitator — do not point this at a different facilitator for
# challenge participation.
TESTNET_FACILITATOR_URL=https://facilitator.goplausible.xyz
MAINNET_FACILITATOR_URL=https://facilitator.goplausible.xyz
