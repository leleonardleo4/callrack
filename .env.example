# Environment mode
NODE_ENV=development

# Infrastructure. In production, append `?sslmode=require` (or
# `?sslmode=no-verify` for a provider with a self-signed/private-CA cert) to
# DATABASE_URL if your Postgres provider requires TLS - `pg` parses this
# automatically, no code change needed. For Redis, use `rediss://` instead
# of `redis://` for TLS (ioredis enables it automatically from the scheme).
DATABASE_URL="postgresql://callrack:callrack_dev_password@localhost:5432/callrack_dev?schema=public"
REDIS_URL="redis://localhost:6379"
# Postgres connection pool size, per API process/replica. Default matches
# `pg`'s own default (10) - lower this if your Postgres plan has a small
# total connection limit and you run multiple replicas (e.g. 4 replicas x
# a pool of 10 = 40 possible connections from this service alone).
DATABASE_POOL_MAX=10

# Ports
API_PORT=3000
WEB_PORT=5173

# API Configuration
API_PREFIX=v1

# Production hardening (Phase 11). All optional - defaults are safe for
# local development.
# Set to false only if the API is NOT behind a reverse proxy/load balancer
# (trusting X-Forwarded-* headers from an untrusted direct client would let
# them spoof their own IP, defeating per-IP rate limiting).
TRUST_PROXY=true
# Max JSON request body size, in bytes. Default (1 MiB) matches Fastify's
# own default; every current capability request body is well under 1 KB.
BODY_LIMIT_BYTES=1048576
# Per-client-IP limit: RATE_LIMIT_MAX requests per RATE_LIMIT_WINDOW_MS.
# Shared across replicas via Redis when reachable; fails open (does not
# block requests) if Redis is unavailable.
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_MS=60000

# Provider configuration (Phase 3)
# Optional "polite pool" identification - leave unset to use the anonymous pool.
OPENALEX_MAILTO=
CROSSREF_MAILTO=
# Optional - only needed if you have a CoinGecko API key.
COINGECKO_API_KEY=
# Optional - only needed for higher US Census API rate limits.
CENSUS_API_KEY=
# Self-hostable providers: point these at your own instance in production.
OPEN_METEO_BASE_URL=https://api.open-meteo.com
PHOTON_BASE_URL=https://photon.komoot.io
WIKIMEDIA_BASE_URL=https://www.wikidata.org
WIKIMEDIA_USER_AGENT=Callrack/0.1 (+https://callrack.dev)

# Capability pricing (Phase 6). Required - every paid capability must have
# an explicit, non-negative decimal price in USDC. There is no default: a
# missing or invalid value fails configuration validation at startup.
PRICE_ACADEMIC_SEARCH=0.01
PRICE_ACADEMIC_WORK=0.005
PRICE_NEWS_SEARCH=0.01
PRICE_NEWS_TRENDS=0.02
PRICE_CRYPTO_PRICE=0.002
PRICE_CRYPTO_MARKET=0.005
PRICE_FX_RATES=0.002
PRICE_WEATHER=0.003
PRICE_GEOCODE=0.002
PRICE_HOLIDAYS=0.002
PRICE_KNOWLEDGE_SEARCH=0.005
PRICE_GOVERNMENT_CENSUS=0.01
PRICE_RESEARCH=0.05
# Information capabilities (Phase 12): compose the same existing providers
# above into higher-value, provenance-rich capabilities.
PRICE_INFORMATION_VERIFY=0.05
PRICE_INFORMATION_EVIDENCE=0.05
PRICE_INFORMATION_COMPARE=0.10

# x402 payment protection (Phase 7). Required - NETWORK selects which PAY_TO
# / FACILITATOR_URL pair below is active; only that pair needs to be valid
# (you don't need Mainnet credentials to develop against Testnet).
# NETWORK=testnet | mainnet
NETWORK=testnet

# Placeholder addresses below are structurally valid but NOT real wallets -
# replace with a real Algorand address you control before accepting any
# actual payment. Never commit a private key or mnemonic to this file.
TESTNET_PAY_TO=TTCZHJ24VWV64DMFCXKHS2GMLFVUTBA673THZR7LNYY3GEB3XV7HNUEQXQ
MAINNET_PAY_TO=V4BOVWHAQJUNZAPU4D7B4N2ALHVMHBRJ2F75EJG5E5XS5JFJZGAU4SS2UA

# GoPlausible facilitator - do not point this at a different facilitator for
# challenge participation.
TESTNET_FACILITATOR_URL=https://facilitator.goplausible.xyz
MAINNET_FACILITATOR_URL=https://facilitator.goplausible.xyz

# Automatic refunds (see docs/REFUNDS.md). Optional per network: leave the
# active network's mnemonic unset to run with refunds "disabled" (a failed
# paid request still gets a durable pending refund record, it just can't be
# submitted on-chain until this is configured). When set, it MUST be the
# 25-word mnemonic of the SAME account as the matching *_PAY_TO above - the
# server verifies this at startup and refuses to start otherwise. Never a
# private key/hex, never commit a real mnemonic, never a Mainnet-funded one
# outside a real deployment's own secret store.
TESTNET_REFUND_MNEMONIC=
MAINNET_REFUND_MNEMONIC=

# Callrack SDK / reference agent (Phase 10). Only needed to run the real
# Testnet smoke test (pnpm test:agent:testnet) or the apps/agent CLI with a
# live signer; the SDK and its normal test suite never need any of these.
# Never commit a real mnemonic, and never use a Mainnet-funded one here.
AVM_MNEMONIC=
CALLRACK_API_URL=http://localhost:3000
AGENT_NETWORK=testnet
AGENT_MAX_BUDGET_USDC=0.25
