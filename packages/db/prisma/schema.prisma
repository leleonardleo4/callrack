datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model Capability {
  id          String   @id @default(uuid())
  slug        String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  requests Request[]
}

model Provider {
  id          String   @id @default(uuid())
  slug        String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  requests Request[]
}

enum RequestStatus {
  SUCCESS
  ERROR
  TIMEOUT
}

model Request {
  id           String        @id @default(uuid())
  requestId    String        @unique
  endpoint     String
  status       RequestStatus
  durationMs   Int
  cacheHit     Boolean       @default(false)
  createdAt    DateTime      @default(now())

  capabilityId String
  capability   Capability @relation(fields: [capabilityId], references: [id])

  providerId String?
  provider   Provider? @relation(fields: [providerId], references: [id])

  @@index([capabilityId])
  @@index([providerId])
  @@index([createdAt])
}
