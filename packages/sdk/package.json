{
  "name": "@callrack/sdk",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./testnet-signer": {
      "types": "./dist/testnet-signer.d.ts",
      "import": "./dist/testnet-signer.mjs",
      "require": "./dist/testnet-signer.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/testnet-signer.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts src/testnet-signer.ts --format cjs,esm --dts --watch",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:agent:testnet": "tsx test/testnet-smoke.ts"
  },
  "dependencies": {
    "@algorandfoundation/algokit-utils": "10.0.0-alpha.46",
    "@x402/avm": "2.26.0",
    "@x402/core": "2.26.0",
    "@x402/fetch": "2.26.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.5",
    "eslint": "^9.21.0",
    "tsup": "^8.4.0",
    "tsx": "^4.23.13",
    "typescript": "^5.8.2",
    "vitest": "^3.0.7"
  }
}
